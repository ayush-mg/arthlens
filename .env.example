# ==============================================================================
# ArthLens Environment Configuration Template (.env.example)
# Authoritative Reference: ArthLens Build Handbook v1.0 (Parts 3.2, 8.3, 8.6, 14)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 16 + PostGIS 3.4)
# ------------------------------------------------------------------------------
POSTGRES_DB=arthlens
POSTGRES_USER=arthlens_dev
POSTGRES_PASSWORD=arthlens_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://arthlens_dev:arthlens_dev_password@127.0.0.1:5432/arthlens

# ------------------------------------------------------------------------------
# 2. Application & Runtime Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Minimum 32-character secret key for JWT session cookies
SECRET_KEY=dev_insecure_secret_key_change_in_production_min_32_chars
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=arthlens_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Quotas (Handbook Part 11)
RATE_LIMIT_PER_MINUTE_IP=60
RATE_LIMIT_PER_MINUTE_USER=120
MAX_COST_USD_PER_DAY=5.00

# ------------------------------------------------------------------------------
# 3. LLM Access Layer & Cost Governance (Handbook Parts 8.3, 8.6, P0-6)
# ------------------------------------------------------------------------------
# Providers: fake | replay | openai | anthropic
LLM_PROVIDER=fake
# Hard budget cap per agent run in USD (Handbook Part 8.3 hypothesis)
MAX_COST_USD_PER_RUN=0.25
# Daily runs allowed per user/role before HTTP 429
DAILY_RUN_QUOTA=50

# Primary model identifiers (verified in Task P0-6)
OPENAI_MODEL_PRIMARY=gpt-6-luna
OPENAI_MODEL_REASONING=gpt-5.6-terra
# Optional API Key (leave empty for zero-cost FakeLLM / ReplayLLM development)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Storage & Static Serving (Cloudflare R2 S3-Compatible)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
# Local directory for development exports and map archives
LOCAL_STORAGE_PATH=./scratch/storage
# Cloudflare R2 configurations for staging/production (Handbook Part 14)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=arthlens-assets
