# ArthLens Deployment Environment Template
POSTGRES_DB=arthlens
POSTGRES_USER=arthlens_dev
POSTGRES_PASSWORD=arthlens_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://arthlens_dev:arthlens_dev_password@127.0.0.1:5432/arthlens
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=replace_with_secure_production_secret_key_minimum_32_characters
LLM_PROVIDER=fake
MAX_COST_USD_PER_RUN=0.25
STORAGE_BACKEND=local
