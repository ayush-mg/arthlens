# ArthLens Deployment Environment Template
POSTGRES_DB=arthlens
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://replace_with_database_user:replace_with_database_password@db:5432/arthlens
ENVIRONMENT=production
APP_ENV=production
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace_with_secure_production_secret_key_minimum_32_characters
SECRET_KEY=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=https://app.example.com
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
MAX_COST_USD_PER_RUN=0.25
STORAGE_BACKEND=local
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
BACKEND_PORT=8000
FRONTEND_PORT=3000
WEB_CONCURRENCY=2

# Bootstrap Administrator Credentials (scripts/bootstrap_admin.py)
ADMIN_BOOTSTRAP_EMAIL=replace_with_admin_email
ADMIN_BOOTSTRAP_PASSWORD=replace_with_secure_admin_password

# Email Delivery (Brevo HTTPS, Resend HTTPS, or SMTP)
# Brevo (Sendinblue) HTTPS API v3 (Sends to ANY email without custom domain via Port 443):
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ArthLens Security

# Resend HTTPS API (Requires custom domain verification):
RESEND_API_KEY=replace_with_resend_api_key
RESEND_FROM_EMAIL=ArthLens <onboarding@resend.dev>

# Optional traditional SMTP (requires unblocked port 587/465):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

