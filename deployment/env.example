# ArthLens Deployment Environment Template
POSTGRES_DB=arthlens
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_HOST=replace_host
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://replace_with_database_user:replace_with_database_password@replace_host:5432/arthlens
ENVIRONMENT=production
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace_with_secure_production_secret_key_minimum_32_characters
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
LLM_PROVIDER=fake
MAX_COST_USD_PER_RUN=0.25
STORAGE_BACKEND=local
